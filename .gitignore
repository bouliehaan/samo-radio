.DS_Store
# The built binary at the repo root — anchored, or this also matches the
# cmd/samo-radio/ DIRECTORY and quietly leaves main.go out of the repo.
/samo-radio
/samo-radio-linux-*
dev-config.json

# Local deploy convenience — hardcodes one particular home server.
deploy.sh
dist/
build/

# Maintainer tooling: deploy.sh ships a worktree to my dev boxes, commit.sh is
# the gate before anything goes public. They live on my machine, not in the
# repo — nobody cloning this can use them.
*.sh
